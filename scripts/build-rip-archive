#!/bin/bash
# Builds the installation archive for a run-in-place LinuxCNC 2.10:
# ecat-rip-<version>-<distro>.tar.gz with ecat.so (libyaml linked in), the
# list of LinuxCNC headers it was built against with their checksums
# (ecat-abi.sha256), EtherCAT Setup and packaging/install-rip.
#
#   . <linuxcnc>/scripts/rip-environment
#   scripts/build-rip-archive [-w] [-o DIR]    -w: the working tree, not HEAD
#
# Needs the LinuxCNC tree of the environment built, libyaml-dev and the
# master's headers in /opt/linuxcnc-ethercat-uspace/include (as for
# `make -C component`).

set -euo pipefail

OUTDIR=$PWD
WORKTREE=
while getopts "o:wh" opt; do
    case $opt in
        w) WORKTREE=1 ;;
        o) OUTDIR=$(realpath "$OPTARG") ;;
        *) sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; exit 1 ;;
    esac
done

[ -n "${EMC2_HOME:-}" ] && [ -d "$EMC2_HOME/include" ] || {
    echo "Read <linuxcnc>/scripts/rip-environment first (EMC2_HOME is not set)." >&2; exit 1; }

SRC=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
ECAT_VERSION=$(sed -n 's/^BASE_VERSION=//p' "$SRC/scripts/build-deb.sh")
DISTRO=$(. /etc/os-release; echo "$ID$VERSION_ID")
NAME=ecat-rip-$ECAT_VERSION-$DISTRO
WORK=$(mktemp -d -t ecat-rip.XXXXXX)
trap 'rm -rf "$WORK"' EXIT
mkdir "$WORK/src" "$WORK/$NAME"
if [ -n "$WORKTREE" ]; then
    (cd "$SRC" && git ls-files -co --exclude-standard -z | tar -c --null -T - -f -) | tar -x -C "$WORK/src"
else
    git -C "$SRC" archive HEAD | tar -x -C "$WORK/src"
fi

echo "=== Building ecat.so (libyaml linked in)"
make -C "$WORK/src/component" YAML_STATIC=1 >/dev/null
cp "$WORK/src/component/ecat.so" "$WORK/$NAME/"

echo "=== The LinuxCNC headers ecat.so was built against"
# the .d files list every header a source file includes
(cd "$WORK/src/component" && cat *.d devices/*.d) | tr ' \\' '\n\n' | grep "^$EMC2_HOME/include/" \
    | sed 's/:$//' | sort -u | sed "s|^$EMC2_HOME/include/||" >"$WORK/headers"
[ -s "$WORK/headers" ] || { echo "no LinuxCNC headers found in the dependency files" >&2; exit 1; }
(cd "$EMC2_HOME/include" && xargs sha256sum <"$WORK/headers") >"$WORK/$NAME/ecat-abi.sha256"
wc -l <"$WORK/headers" | sed 's/$/ headers/'

echo "=== Files"
LC=$(git -C "$EMC2_HOME" describe --always --dirty 2>/dev/null || echo unknown)
LCC=$(git -C "$EMC2_HOME" rev-parse HEAD 2>/dev/null || echo unknown)
cat >"$WORK/$NAME/BUILD-INFO" <<EOF
ecat $ECAT_VERSION (ecat-v$ECAT_VERSION, $(git -C "$SRC" rev-parse --short HEAD))
linuxcnc $LC $LCC
distro $DISTRO
EOF
cp -r "$WORK/src/ecatsetup" "$WORK/$NAME/"
find "$WORK/$NAME" -name __pycache__ -prune -exec rm -rf {} +
mkdir "$WORK/$NAME/docs"
cp "$WORK/src/README.md" "$WORK/$NAME/"
cp "$WORK/src/docs"/*.md "$WORK/$NAME/docs/"
cp -r "$WORK/src/docs/images" "$WORK/$NAME/docs/"
cp "$WORK/src/LICENSE" "$WORK/$NAME/"
cp "$WORK/src/scripts/ecat-take-down" "$WORK/$NAME/"
cp "$WORK/src/packaging/install-rip" "$WORK/$NAME/install"
chmod 755 "$WORK/$NAME/install"

mkdir -p "$OUTDIR"
tar -C "$WORK" -czf "$OUTDIR/$NAME.tar.gz" "$NAME"
echo "Built $OUTDIR/$NAME.tar.gz"
