#!/usr/bin/env python3
"""Run the Python test modules in parallel, one process per module.

    scripts/run-tests            # all of tests/test_*.py
    scripts/run-tests gui wiring # only tests/test_gui.py and tests/test_wiring.py
    scripts/run-tests -j 2       # at most 2 at a time (default: the CPUs)

Each module runs as `python3 -m unittest tests.<module>` with the window
offscreen. Every test module keeps its temporary files in a folder of its
own process, so modules do not share state. The output of a module is
shown only when it fails; the end lists every module with its time.
Exit status 1 when a module fails.
"""
import argparse
import os
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
# the slowest first, so that they do not start last
FIRST = ["test_gui", "test_integrate", "test_drivetest", "test_capture", "test_prototype"]


def modules(names):
    found = sorted(f[:-3] for f in os.listdir(os.path.join(ROOT, "tests"))
                   if f.startswith("test_") and f.endswith(".py"))
    if names:
        want = [n if n.startswith("test_") else "test_" + n for n in names]
        missing = [n for n in want if n not in found]
        if missing:
            sys.exit("no such test module: %s" % ", ".join(missing))
        found = want
    return sorted(found, key=lambda m: (FIRST.index(m) if m in FIRST else len(FIRST), m))


def run(module):
    env = dict(os.environ, QT_QPA_PLATFORM="offscreen", PYTHONDONTWRITEBYTECODE="1")
    t0 = time.time()
    r = subprocess.run([sys.executable, "-m", "unittest", "tests." + module], cwd=ROOT, env=env,
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    return module, r.returncode, time.time() - t0, r.stdout


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("module", nargs="*", help="test modules, with or without test_")
    ap.add_argument("-j", "--jobs", type=int, default=os.cpu_count() or 2)
    a = ap.parse_args()
    t0 = time.time()
    results = []
    with ThreadPoolExecutor(max_workers=max(1, a.jobs)) as pool:
        for module, code, secs, out in pool.map(run, modules(a.module)):
            results.append((module, code, secs, out))
            if code != 0:
                print("=" * 70)
                print("%s FAILED" % module)
                print(out)
    tests = 0
    for module, code, secs, out in sorted(results, key=lambda r: -r[2]):
        n = next((int(line.split()[1]) for line in out.splitlines() if line.startswith("Ran ")), 0)
        tests += n
        print("%-22s %5.1f s  %4d tests  %s" % (module, secs, n, "ok" if code == 0 else "FAILED"))
    failed = [m for m, c, _, _ in results if c != 0]
    print("%d tests in %d modules, %.1f s%s" % (tests, len(results), time.time() - t0,
                                                  ", FAILED: " + ", ".join(failed) if failed else ", all ok"))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
