#!/bin/bash
# Build ecat.so and run the C unit tests against LinuxCNC 2.9's headers, in a
# copy of component/ (the checkout's own build stays the 2.10 one).
#
#   scripts/check-component-2.9 [-o DIR] [HALCOMPILE]
#
# -o DIR: keep the 2.9 ecat.so there. HALCOMPILE: 2.9's halcompile (default /usr/bin/halcompile, from the
# linuxcnc-uspace-dev package). A run-in-place environment in the shell is
# left out: the build gets a PATH without it.
set -e
out=
if [ "$1" = -o ]; then out=$2; shift 2; fi
comp=${1:-/usr/bin/halcompile}
[ -x "$comp" ] || { echo "no halcompile at $comp (install linuxcnc-uspace-dev 2.9)" >&2; exit 2; }
top=$(cd "$(dirname "$0")/.." && pwd)
work=$(mktemp -d "${TMPDIR:-/tmp}/ecat-check-2.9.XXXXXX")
trap 'rm -rf "$work"' EXIT
tar -C "$top" --exclude='*.o' --exclude='*.d' --exclude='*.so' -cf - component | tar -C "$work" -xf -
find "$work/component/tests" -maxdepth 1 -type f -name 'test_*' ! -name '*.*' -delete
version=$(dpkg-query -W -f='${Version}' linuxcnc-uspace-dev 2>/dev/null || true)
echo "LinuxCNC 2.9 headers: $(dirname "$comp") ${version}"
env -i HOME="$HOME" PATH="$(dirname "$comp"):/usr/bin:/bin" ${USPACE_ETHERCAT:+USPACE_ETHERCAT=$USPACE_ETHERCAT} \
  make -C "$work/component" COMP="$comp" -j"$(nproc)" all check
[ -z "$out" ] || { mkdir -p "$out"; cp "$work/component/ecat.so" "$out/"; echo "kept $out/ecat.so"; }
