#!/usr/bin/env python3
"""Print the ecat event log live, one line per new event or master's
message, until Ctrl-C.

For fault tests at the machine: leave it running in a terminal, provoke
the fault, and see at once what the recorder caught. Usage:

    scripts/ecat-events-follow [--ini MACHINE.ini]
"""
import os
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
from ecatsetup import events  # noqa: E402


def main():
    seen = None          # (run, index of the last event printed)
    seen_text = -1       # index of the last master's message printed
    print("Following %s (Ctrl-C to stop)" % events.PATH)
    try:
        while True:
            try:
                log = events.read()
            except events.EventsError:
                time.sleep(0.5)
                continue
            key = log.pid
            if seen is None:
                seen = (key, -1)
            elif seen[0] != key or log.total <= seen[1]:
                print("--- a new run started ---")
                seen, seen_text = (key, -1), -1
            texts = events.annotate(log.events)
            marks = {"info": "", "warn": "WARN", "error": "ERROR"}
            new_events = [e for e in log.events if e.index > seen[1]]
            new_texts = [(t, 1) for t in (log.texts or []) if t.index > seen_text]
            for kind, x in events.merged(log, new_events, new_texts):
                if kind == "event":
                    sev, msg = texts[x.index]
                    print("%s %-5s %s" % (events.stamp(x.time), marks[sev], msg), flush=True)
                    seen = (key, x.index)
                else:
                    t = x[0]
                    print("%s %-5s %s" % (events.stamp(t.time), marks[t.severity],
                                          events.text_line(t)), flush=True)
                    seen_text = t.index
            time.sleep(0.2)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
